# Copy to .env and fill in. Used by `docker compose up`.
# For running outside Docker, clover-api/.env is the one that matters.

# Must be at least 32 characters.
JWT_SECRET=

# Google OAuth — leave blank to disable Google sign-in (guest + email/password still work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser reaches the app. Used for OAuth redirects and CORS.
# 3000 is the nginx-served web container; use 5173 if running Vite directly.
FRONTEND_URL=http://localhost:3000

# Upstream providers — defaults are fine.
ASURASCANS_BASE_URL=https://asurascans.com
MANGAPLUS_API_URL=https://jumpg-webapi.tokyo-cdn.com
